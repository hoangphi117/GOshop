# Binaries
bin/
**/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test

# Go workspace
go.work
go.work.sum

# Air
tmp/
**/tmp/
build.log

# Secrets / env
.env
.env.local
# The root-level file is a stale copy kept only while migrating to backend/.env;
# it must never be committed.
.env.system-backup
**/.env
**/.env.local
**/.env*.local
# Environment VARIANTS are committed on purpose (no secrets in .env.prod path
# unless real secrets are added): switching dev<->prod is `make env-prod`.
backend/.env.dev
backend/.env.prod
frontend/apps/storefront/.env.dev
frontend/apps/storefront/.env.prod

# Runtime data
.runtime/

# Database dumps
backupdb.sql

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp

# CI
coverage.out

# User uploads
uploads/
**/uploads/

# Frontend (Node / Next.js / Turbo)
node_modules/
**/node_modules/
.next/
**/.next/
.turbo/
**/.turbo/
dist/
**/dist/
out/
**/out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Unit test coverage
*.out
coverage.*


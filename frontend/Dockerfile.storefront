FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV CI=true
RUN corepack enable

FROM base AS builder
WORKDIR /app
# NEXT_PUBLIC_* values are inlined at build time, so the API origin must be
# supplied here rather than in docker-compose `environment` alone.
ARG NEXT_PUBLIC_API_URL=http://localhost
# No API key here: the edge injects X-API-KEY server-side, so nothing is baked
# into the image layer or the client bundle.
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/ ./packages/
COPY apps/storefront/ ./apps/storefront/

RUN pnpm install --frozen-lockfile
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter storefront build

# Runner: only the traced standalone bundle. No pnpm, no full node_modules —
# outputFileTracingRoot puts the workspace root at /app, so the server entry
# is /app/apps/storefront/server.js.
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

COPY --from=builder /app/apps/storefront/.next/standalone ./
COPY --from=builder /app/apps/storefront/.next/static ./apps/storefront/.next/static
COPY --from=builder /app/apps/storefront/public ./apps/storefront/public

EXPOSE 3000
CMD ["node", "apps/storefront/server.js"]


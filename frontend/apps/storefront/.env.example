# Public Backend API Gateway URL (accessed by client browsers)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Internal Backend URL (used by Next.js Server Components / SSR / rewrites)
INTERNAL_API_URL=http://localhost:8080

# Storefront API Gateway Key
NEXT_PUBLIC_API_KEY=abcd-1234-1111

# WebSocket URL for real-time order/notifications
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# Public Storefront Domain (used for Canonical URLs, OpenGraph, Sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Google OAuth 2.0 Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Direct Meilisearch Search (Offloads Search from Backend API & PostgreSQL Master)
# Client browser direct query URL (e.g. http://localhost:7700 or /search-api via Nginx)
NEXT_PUBLIC_MEILISEARCH_URL=
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=
# Internal Server Components direct query URL (e.g. http://meilisearch:7700 in docker)
INTERNAL_MEILISEARCH_URL=
MEILISEARCH_SEARCH_KEY=

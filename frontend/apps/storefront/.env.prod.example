# PROD EXAMPLE - copy to frontend/apps/storefront/.env.prod then fill.
# The real .env.prod is git-ignored. Only ONE place changes per deploy:
# NEXT_PUBLIC_SITE_URL (canonical/OG/sitemap). API URL stays the edge origin.
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# origin switched to the real edge. Dev (next dev on :3000/:3001) keeps .env.
#
# EVERYTHING is same-origin through the edge: nginx serves the storefront,
# proxies /api/v1, /goshop-media and the WebSocket at /api/v1/ws. So the only
# value that changes per environment is the public site URL (used by
# sitemap.ts / robots.ts canonical + OpenGraph, not by API calls).
#
# Change the domain in ONE place (the three *localhost* URLs below), or rely on
# the backend's APP_ORIGIN-derived defaults for the server-side values.
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# Public Backend API Gateway URL (accessed by client browsers) â€” same origin.
NEXT_PUBLIC_API_URL=http://localhost

# Internal Backend URL (Next.js Server Components / SSR / rewrites). In the
# container this is the compose service name, NOT the edge â€” SSR must not
# round-trip through nginx.
INTERNAL_API_URL=http://nginx

# Storefront API Gateway Key (baked into the client bundle at build time).
NEXT_PUBLIC_API_KEY=abcd-1234-1111

# Public Storefront Domain (used for Canonical URLs, OpenGraph, Sitemap).
# REPLACE with the real domain at deploy time, e.g. https://shop.example.com
NEXT_PUBLIC_SITE_URL=http://localhost

# Google OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=15747195180-f3n3p6cujlr9vthn0fd5199pi703f0ah.apps.googleusercontent.com

NEXT_PUBLIC_GOOGLE_CLIENT_ID=15747195180-f3n3p6cujlr9vthn0fd5199pi703f0ah.apps.googleusercontent.com

# Direct Meilisearch search â€” client goes through the edge (/search-api proxy).
NEXT_PUBLIC_MEILISEARCH_URL=http://localhost/search-api
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=masterKey123

# Internal Server Components direct query URL (compose service name).
INTERNAL_MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_SEARCH_KEY=masterKey123

{
  "name": "goshop-frontend",
  "private": true,
  "scripts": {
    "dev:dashboard": "turbo run dev --filter=dashboard",
    "dev:storefront": "turbo run dev --filter=storefront",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "node scripts/clean.mjs",
    "gen:api": "turbo run gen:api --filter=@goshop/api-client"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@11.1.1"
}

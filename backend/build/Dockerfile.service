# Production image for every Go service.
#
# One template, one ARG: the caller passes `SERVICE` (the cmd/ subdirectory) so
# adding a service never adds a Dockerfile. Build:
#   docker build -f build/Dockerfile.service --build-arg SERVICE=order .
#
# The backend is a Go workspace (back end/go.work): gomod/shared holds the
# reusable packages, gomod/contracts the event payloads, gomod/services the
# domains, gomod/cmd the binaries. Shared dependencies are downloaded once from
# the shared module, so a change to one service does not invalidate the
# dependency layer for the others.
FROM golang:1.26.10-alpine AS builder

RUN apk add --no-cache ca-certificates

WORKDIR /app

# Workspace definition first: it is tiny and changes rarely.
COPY go.work ./
COPY gomod/shared/go.mod gomod/shared/go.sum ./gomod/shared/
COPY gomod/contracts/go.mod gomod/contracts/go.sum ./gomod/contracts/
COPY gomod/services/go.mod gomod/services/go.sum ./gomod/services/
COPY gomod/cmd/go.mod gomod/cmd/go.sum ./gomod/cmd/

# Workspace mode resolves every module's dependencies in one shot.
# BuildKit cache mounts persist the module and build caches across builds,
# so rebuilding one service reuses compiled packages from prior builds
# instead of recompiling the whole workspace from scratch.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod download

COPY . .

ARG SERVICE
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    test -n "$SERVICE" \
    && cd gomod/cmd \
    && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-w -s" -o /service ./${SERVICE}

FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app
COPY --from=builder /service /app/service

# The binary is a shared /app/service in every image, so the log bucket cannot
# be derived from the executable name — bake the service name in.
ARG SERVICE
ENV APP_ENV=production
ENV SERVICE_NAME=${SERVICE}
ENV GOMEMLIMIT=128MiB
ENV GOMAXPROCS=1

EXPOSE 8080 8081 8082 8083 8084 8085 8086 8087 8088 8089 8090 8091 8092 8093 8094

ENTRYPOINT ["/app/service"]

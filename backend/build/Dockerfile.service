# Production image for every Go service.
#
# One template, one ARG: the caller passes `SERVICE` (the cmd/ subdirectory) so
# adding a service never adds a Dockerfile. Build:
#   docker build -f build/Dockerfile.service --build-arg SERVICE=order .
FROM golang:1.26.6-alpine AS builder

RUN apk add --no-cache ca-certificates

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG SERVICE
RUN test -n "$SERVICE" && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-w -s" -o /service ./cmd/${SERVICE}

FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app
COPY --from=builder /service /app/service

# The binary is a shared /app/service in every image, so the log bucket cannot
# be derived from the executable name — bake the service name in.
ARG SERVICE
ENV APP_ENV=production
ENV SERVICE_NAME=${SERVICE}
ENV GOMEMLIMIT=128MiB
ENV GOMAXPROCS=1

EXPOSE 8080 8081 8082 8083 8084 8085 8086 8087 8088 8089 8090 8091 8092 8093 8094

ENTRYPOINT ["/app/service"]

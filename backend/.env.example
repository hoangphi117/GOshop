# =============================================================================
# GOshop backend — full environment template
# =============================================================================
# Copy to `backend/.env` (the services read that literal path via env_file).
# Every value marked CHANGE_ME is a secret: generate it, never commit it.
#
# Browser-facing URLs derive from ONE switch: APP_ORIGIN. Change it there,
# not in the per-service URLs below.
# =============================================================================


# =============================================================================
# 1. RUNTIME
# =============================================================================
APP_ENV=development
APP_ORIGIN=http://localhost
SERVER_PORT=8080
APP_URL=http://localhost:8080
# Dev pins the storefront dev server so email-verify/reset links work without
# the edge. Prod derives this from APP_ORIGIN.
STOREFRONT_URL=http://localhost:3001

# Edge API key: nginx injects it as X-API-KEY on /api/v1/*. Server-side secret,
# never baked into a frontend bundle.
API_KEY=CHANGE_ME

# Service-to-service shared secret.
INTERNAL_API_SECRET=CHANGE_ME


# =============================================================================
# 2. DATABASE (PostgreSQL)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_SSL_MODE=disable

# Connection pool tuning.
DB_MAX_CONNS=20
DB_MIN_CONNS=5

# Per-service databases (compose creates them from scripts/init_databases.sql).
NOTIFICATION_DB_NAME=shopping_notification
PAYMENT_DB_NAME=shopping_payment
ORDER_DB_NAME=shopping_order
CHAT_DB_NAME=shopping_chat

# Optional read replica for analytics / reporting. Leave empty to use primary.
DB_READ_REPLICA_URL=
DB_READ_MAX_CONNS=15
DB_READ_MIN_CONNS=3
# Or discrete fields instead of the URL:
# DB_READ_HOST=
# DB_READ_PORT=
# DB_READ_NAME=
# DB_READ_USER=
# DB_READ_PASSWORD=
# DB_READ_SSL_MODE=

# Optional independent identity database. Empty = primary DB.
DB_IDENTITY_URL=
DB_IDENTITY_MAX_CONNS=15
DB_IDENTITY_MIN_CONNS=3


# =============================================================================
# 3. REDIS
# =============================================================================
REDIS_ADDR=localhost:6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=0


# =============================================================================
# 4. KAFKA
# =============================================================================
# Brokers: host services read localhost:9092, container services read
# kafka:29092 (dual advertised listeners in compose).
KAFKA_BROKERS=localhost:9092
KAFKA_MAX_RETRIES=3
KAFKA_CONSUMER_COUNT=3
KAFKA_RETRY_BACKOFF_BASE_MS=1000


# =============================================================================
# 5. AUTHENTICATION (JWT, RS256)
# =============================================================================
# Only `identity` signs tokens; every other service verifies with the public
# key. A verifier that misses JWT_PUBLIC_KEY mints an ephemeral key and every
# authenticated request 401s.
JWT_KEY_ID=goshop-key-1
JWT_SIGNING_ENABLED=true
# PEM string or file path (prod compose mounts ./backend/certs at /app/certs).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Legacy HMAC settings, kept for backwards compatibility.
JWT_SECRET=CHANGE_ME
JWT_ENCRYPT_KEY=CHANGE_ME_32_BYTES

# Optional Google OAuth login. Leave empty to disable.
GOOGLE_CLIENT_ID=


# =============================================================================
# 6. OBJECT STORAGE (MinIO / Cloudflare R2 / AWS S3)
# =============================================================================
# Local disk storage is removed: all uploads go to object storage.
#
# Dev uses MinIO; prod uses R2. Compose no longer pins S3_ENDPOINT, so this
# block is the single source of truth for both.

# --- Option A: local MinIO (dev) ---
STORAGE_DRIVER=minio
S3_ENDPOINT=http://minio:9000
S3_REGION=auto
S3_BUCKET=goshop-media
S3_ACCESS_KEY=goshop_admin
S3_SECRET_KEY=CHANGE_ME
S3_USE_PATH_STYLE=true
S3_USE_SSL=false
# Serve MinIO through the edge (no published port): S3_PUBLIC_BASE_URL=<origin>/goshop-media
S3_PUBLIC_BASE_URL=http://localhost:9000/goshop-media

# --- Option B: Cloudflare R2 (prod, 10 GB free, no egress fee) ---
# STORAGE_DRIVER=r2
# S3_ENDPOINT=https://<CF_ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=goshop-media
# S3_ACCESS_KEY=CHANGE_ME
# S3_SECRET_KEY=CHANGE_ME
# S3_USE_PATH_STYLE=false
# S3_USE_SSL=true
# S3_PUBLIC_BASE_URL=https://pub-<random>.r2.dev

# --- Option C: AWS S3 ---
# STORAGE_DRIVER=s3
# S3_ENDPOINT=
# S3_REGION=ap-southeast-1
# S3_BUCKET=goshop-media
# S3_ACCESS_KEY=CHANGE_ME
# S3_SECRET_KEY=CHANGE_ME
# S3_USE_PATH_STYLE=false
# S3_USE_SSL=true
# S3_PUBLIC_BASE_URL=https://goshop-media.s3.ap-southeast-1.amazonaws.com


# =============================================================================
# 7. SEARCH (Meilisearch)
# =============================================================================
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=CHANGE_ME
MEILISEARCH_INDEX_PRODUCTS=products


# =============================================================================
# 8. EMAIL (Mailtrap API — sandbox or live inbox)
# =============================================================================
# Get the API key from mailtrap.io > Settings > API Tokens.
MAIL_PROVIDER_TYPE=mailtrap
MAILTRAP_API_KEY=CHANGE_ME
MAILTRAP_SANDBOX_ID=CHANGE_ME
MAILTRAP_USE_SANDBOX=true
MAILTRAP_MAIL_SENDER=CHANGE_ME
MAILTRAP_MAIL_SENDER_NAME=GOshop


# =============================================================================
# 9. SHIPPING (GHN)
# =============================================================================
GHN_BASE_URL=https://dev-online-gateway.ghn.vn
GHN_TOKEN=CHANGE_ME
GHN_SHOP_ID=CHANGE_ME
GHN_CALLBACK_URL=
SHIPPING_SYNC_INTERVAL_MINUTES=30


# =============================================================================
# 10. PAYMENT (MoMo / VNPay)
# =============================================================================
# Endpoints below are the public sandbox ones; merchant credentials are yours.
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=CHANGE_ME
MOMO_SECRET_KEY=CHANGE_ME
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

VNPAY_TMN_CODE=CHANGE_ME
VNPAY_HASH_SECRET=CHANGE_ME
VNPAY_ENDPOINT=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# Both derive from APP_ORIGIN in prod; set explicitly only to override.
PAYMENT_RETURN_URL=http://localhost:3001/payment/result
# Must be a public URL the provider can reach (use a tunnel in dev).
PAYMENT_WEBHOOK_BASE_URL=
PAYMENT_CB_MAX_FAILURES=5
PAYMENT_CB_TIMEOUT_SECONDS=30
PAYMENT_CB_MAX_REQUESTS=1


# =============================================================================
# 11. RATE LIMITING
# =============================================================================
RATE_LIMITER_REQUESTS_SEC=5
RATE_LIMITER_REQUESTS_BURST=10
RATE_LIMITER_PUBLIC_SEC=100
RATE_LIMITER_PUBLIC_BURST=200
RATE_LIMITER_INTERNAL_SEC=50000
RATE_LIMITER_INTERNAL_BURST=100000
LIMIT_ITEM_PER_PAGE=10


# =============================================================================
# 12. INTER-SERVICE TOPOLOGY
# =============================================================================
# Host-side dev values. Compose overrides these with container DNS names.
IDENTITY_SERVICE_URL=http://localhost:8081
IDENTITY_GRPC_ADDR=localhost:50051
IDENTITY_GRPC_PORT=50051

NOTIFICATION_SERVICE_URL=http://localhost:8082

PAYMENT_SERVICE_URL=http://localhost:8083
PAYMENT_GRPC_ADDR=localhost:50052
PAYMENT_SERVER_PORT=8083
PAYMENT_GRPC_PORT=50052

ORDER_SERVICE_URL=http://localhost:8088
ORDER_GRPC_ADDR=localhost:50057
ORDER_GRPC_TARGET=localhost:50057
ORDER_SERVER_PORT=8088
ORDER_GRPC_PORT=50057

# ws-gateway owns 8085.
INVENTORY_SERVICE_URL=http://localhost:8090
INVENTORY_GRPC_ADDR=localhost:50054
INVENTORY_SERVER_PORT=8090
INVENTORY_GRPC_PORT=50054

ANALYTICS_SERVICE_URL=http://localhost:8092
ANALYTICS_SERVER_PORT=8092

CHAT_SERVICE_URL=http://localhost:8093
CHAT_GRPC_TARGET=localhost:50058
CHAT_SERVER_PORT=8093
CHAT_GRPC_PORT=50058

MEDIA_SERVICE_URL=http://localhost:8094
MEDIA_SERVER_PORT=8094

WS_GATEWAY_URL=http://localhost:8085


# =============================================================================
# 13. OBSERVABILITY (Grafana Cloud)
# =============================================================================
# Logs. Create a stack at grafana.com > Cloud (free tier) > Connections > Loki;
# token scope: logs:write. The read token is only needed by scripts/logq.ps1.
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
GRAFANA_LOKI_TOKEN=
GRAFANA_LOKI_READ_TOKEN=

# Traces (prod only; dev compose points OTel at the local jaeger:4318).
# Copy the OTLP endpoint and a traces:write token from the portal's
# "Send traces with OTLP" page, then build the Basic header:
#   [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes('USER:TOKEN'))
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(instance-id:token)>
# OTEL_TRACES_SAMPLER_ARG=0.1

# Alerting webhook. Leave empty to disable.
DISCORD_WEBHOOK_URL=


# =============================================================================
# 14. LOAD TESTING (k6)
# =============================================================================
TOTAL_PRODUCTS=5032
CATEGORY_PARAM=category_uuid
PRODUCT_PATH=/api/v1/products
TARGET_RATE=150
BASE_RATE=100
BREAKING_RATE=1500
PEAK_RATE=1000

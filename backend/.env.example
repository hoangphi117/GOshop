API_KEY=change-me
SERVER_PORT=8080
APP_ENV=development
APP_URL=http://localhost:8080
STOREFRONT_URL=http://localhost:3001

# JWT RS256
JWT_KEY_ID=goshop-key-1
JWT_PRIVATE_KEY=certs/jwt_private.pem
JWT_PUBLIC_KEY=certs/jwt_public.pem

# Internal Service-to-Service Secret Token (must be strong secret in production)
INTERNAL_API_SECRET=change-me-to-a-very-long-secret-token

DB_HOST=localhost
DB_PORT=5432
DB_NAME=goshop
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=disable

# Read-Replica Connection (Analytics / Reporting / Heavy Reads)
# Defaults to Primary DB if unset. Set to read-replica instance to offload master DB.
DB_READ_REPLICA_URL=
# Or discrete fields:
# DB_READ_HOST=localhost
# DB_READ_PORT=5433
# DB_READ_NAME=goshop
# DB_READ_USER=postgres
# DB_READ_PASSWORD=postgres
# DB_READ_SSL_MODE=disable
DB_READ_MAX_CONNS=15
DB_READ_MIN_CONNS=3

# Identity Service Database Connection (Microservices Decoupling)
# Set to independent database URL (e.g. postgres://postgres:postgres@localhost:5432/goshop_identity?sslmode=disable).
# If left empty, defaults to Primary DB without breaking changes.
DB_IDENTITY_URL=
DB_IDENTITY_MAX_CONNS=15
DB_IDENTITY_MIN_CONNS=3

# Inter-Service Communication
# 1. Reverse Proxy Gateway for public REST (Auth, Users, Addresses)
IDENTITY_SERVICE_URL=http://localhost:8081
# 2. Inter-Service IPC via gRPC (High-performance binary protocol)
IDENTITY_GRPC_ADDR=localhost:50051
IDENTITY_GRPC_PORT=50051
INTERNAL_API_SECRET=goshop-internal-secret-token

# Database Connection Pool Tuning
DB_MAX_CONNS=20
DB_MIN_CONNS=5

# Rate Limiter Tuning
RATE_LIMITER_REQUESTS_SEC=5
RATE_LIMITER_REQUESTS_BURST=10
RATE_LIMITER_PUBLIC_SEC=100
RATE_LIMITER_PUBLIC_BURST=200
RATE_LIMITER_INTERNAL_SEC=50000
RATE_LIMITER_INTERNAL_BURST=100000

# Load Testing Configuration (Grafana k6)
TOTAL_PRODUCTS=5032
CATEGORY_PARAM=category_uuid
PRODUCT_PATH=/api/v1/products
TARGET_RATE=150
BASE_RATE=100
BREAKING_RATE=1500
PEAK_RATE=1000

LIMIT_ITEM_PER_PAGE=10

REDIS_ADDR=localhost:6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=0

RABBITMQ_URL=amqp://goshop:goshop@localhost:5672/
RABBITMQ_USER=goshop
RABBITMQ_PASSWORD=goshop
RABBITMQ_PREFETCH_COUNT=10
RABBITMQ_MESSAGE_TTL_MS=3600000
RABBITMQ_MAX_RETRIES=3
RABBITMQ_CONSUMER_COUNT=3

JWT_SECRET=change-me
JWT_ENCRYPT_KEY=
# JWT Asymmetric (RS256) & JWKS (Microservices offline verification)
# In production, set PEM string or file path (e.g. ./keys/jwt_private.pem / ./keys/jwt_public.pem).
# If left empty in development/test, an ephemeral RSA-2048 keypair is automatically generated on boot.
JWT_KEY_ID=goshop-key-1
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

MAIL_PROVIDER_TYPE=mailtrap
MAILTRAP_API_KEY=your-mailtrap-api-key
MAILTRAP_SANDBOX_ID=your-sandbox-id
MAILTRAP_USE_SANDBOX=true
MAILTRAP_MAIL_SENDER=admin@goshop.com
MAILTRAP_MAIL_SENDER_NAME=GOshop

# Shipping (GHN)
GHN_BASE_URL=https://dev-online-gateway.ghn.vn
GHN_TOKEN=your-ghn-token
GHN_SHOP_ID=your-shop-id
GHN_CALLBACK_URL=https://your-domain.com/api/v1/shipping/webhook/ghn
SHIPPING_SYNC_INTERVAL_MINUTES=30

# Payment (MoMo / VNPay)
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=your-momo-access-key
MOMO_SECRET_KEY=your-momo-secret-key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
PAYMENT_RETURN_URL=http://localhost:3001/payment/result
PAYMENT_WEBHOOK_BASE_URL=https://your-domain.com
PAYMENT_CB_MAX_FAILURES=5
PAYMENT_CB_TIMEOUT_SECONDS=30
PAYMENT_CB_MAX_REQUESTS=1

# Google OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# =============================================================================
# OBJECT STORAGE CONFIGURATION (LOCAL / MINIO / CLOUDFLARE R2 / AWS S3)
# =============================================================================

# --- OPTION 1: CLOUDFLARE R2 (FREE 10GB & 0$ EGRESS - RECOMMENDED) ---
STORAGE_DRIVER=r2
S3_ENDPOINT=https://<YOUR_CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=goshop-media
S3_ACCESS_KEY=your_r2_access_key_id
S3_SECRET_KEY=your_r2_secret_access_key
S3_USE_PATH_STYLE=false
S3_USE_SSL=true
S3_PUBLIC_BASE_URL=https://pub-your-subdomain.r2.dev
# Or if using custom domain: S3_PUBLIC_BASE_URL=https://cdn.yourshop.com

# --- OPTION 2: LOCAL MINIO (DOCKER TESTING) ---
# STORAGE_DRIVER=minio
# S3_ENDPOINT=http://minio:9000
# S3_REGION=auto
# S3_BUCKET=goshop-media
# S3_ACCESS_KEY=goshop_admin
# S3_SECRET_KEY=goshop_secret_key
# S3_USE_PATH_STYLE=true
# S3_USE_SSL=false
# S3_PUBLIC_BASE_URL=http://localhost:9000/goshop-media

# --- OPTION 3: LOCAL DISK ---
# STORAGE_DRIVER=local
# UPLOAD_DIR=./uploads
# STORAGE_PUBLIC_BASE_URL=http://localhost:8080

# --- OPTION 4: AWS S3 ---
# STORAGE_DRIVER=s3
# S3_ENDPOINT=
# S3_REGION=ap-southeast-1
# S3_BUCKET=goshop-media
# S3_ACCESS_KEY=your_aws_access_key_id
# S3_SECRET_KEY=your_aws_secret_access_key
# S3_USE_PATH_STYLE=false
# S3_USE_SSL=true
# S3_PUBLIC_BASE_URL=https://goshop-media.s3.ap-southeast-1.amazonaws.com

# =============================================================================
# SEARCH ENGINE (MEILISEARCH)
# =============================================================================
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=masterKey123
MEILISEARCH_INDEX_PRODUCTS=products

# =============================================================================
# MONITORING & ALERTING
# =============================================================================
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token


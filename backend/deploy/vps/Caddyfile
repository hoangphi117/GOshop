# Caddy terminates TLS and proxies to the Go gateway.
#
# The gateway already proxies /api/v1/* to the 16 sibling services over
# 127.0.0.1 inside the container, so Caddy only needs one upstream.
#
# TLS: the A record for api.goshop.dpdns.org is Cloudflare-proxied, so
# Let's Encrypt HTTP-01 cannot complete and Caddy would never reach a
# certificate on its own. Instead Caddy serves a Cloudflare Origin Certificate,
# minted in the dashboard under SSL/TLS -> Origin Server. That keeps the
# Cloudflare->origin hop encrypted and lets the zone stay on Full (strict).
#
# The origin cert is issued for api.goshop.dpdns.org and lasts 15 years, so
# there is no renewal task here. Put origin.pem and origin.key in deploy/vps/
# certs/ (gitignored) before starting Caddy.

api.goshop.dpdns.org {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	# Cloudflare passes the real scheme in X-Forwarded-Proto; Caddy needs it to
	# build absolute URLs and to answer redirects correctly.
	reverse_proxy backend:8080 {
		header_up X-Real-IP {remote_host}
		# Long enough for the outbox worker's bulk enqueue and for large
		# product imports on the admin surface.
		transport http {
			response_header_timeout 120s
		}
	}

	encode gzip zstd

	log {
		output file /data/access.log {
			roll_size 50MiB
			roll_keep 5
		}
	}
}

# Plain-HTTP block so a bare curl to the VM IP, and the container healthcheck,
# still answer. Caddy also uses it for the Cloudflare->origin redirect target.
:80 {
	respond /healthz "ok"
	reverse_proxy /api/* backend:8080
}

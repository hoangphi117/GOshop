# ============= STAGE 1: BUILD GO BINARY =============
FROM golang:1.26.6-alpine AS builder

RUN apk update && apk add --no-cache git curl ca-certificates tzdata

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o notification ./cmd/notification

# ============= STAGE 2: RUNTIME CONTAINER =============
FROM alpine:3.19

# The binary is a shared /app/main in this image, so the log bucket cannot
# be derived from the executable name - bake the service name in.
ENV SERVICE_NAME=notification

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

COPY --from=builder /app/notification .

EXPOSE 8082

CMD ["./notification"]

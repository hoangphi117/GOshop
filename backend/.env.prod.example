# PROD EXAMPLE - copy to backend/.env.prod, then fill every CHANGE_ME.
# backend/.env.prod is git-ignored because it holds real secrets.
# Single switch: APP_ORIGIN derives storefront links, VNPay return URL and
# the public media base (see internal/config/config_origin_test.go).
API_KEY=CHANGE_ME
SERVER_PORT=8080
APP_ENV=development
BASE_URL=http://localhost

# JWT RS256
JWT_KEY_ID=goshop-key-1
JWT_PRIVATE_KEY=certs/jwt_private.pem
JWT_PUBLIC_KEY=certs/jwt_public.pem

# Internal Service-to-Service Secret Token
INTERNAL_API_SECRET=CHANGE_ME

# DATABASE
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
IDENTITY_DB_NAME=shopping_identity
COUPON_DB_NAME=shopping_coupon
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_SSL_MODE=disable

# Database Connection Pool Tuning
# Read-Replica Connection (Analytics / Reporting / Heavy Reads)
# Defaults to Primary DB if unset. Set to read-replica instance to offload master DB.
# DB_READ_REPLICA_URL=postgres://postgres:postgres@localhost:5433/goshop?sslmode=disable
# Or discrete fields:
# DB_READ_HOST=localhost
# DB_READ_PORT=5433
# DB_READ_NAME=goshop
# DB_READ_USER=postgres
# DB_READ_PASSWORD=postgres
# DB_READ_SSL_MODE=disable
DB_READ_MAX_CONNS=15
DB_READ_MIN_CONNS=3
DB_MAX_CONNS=20
DB_MIN_CONNS=5


# =============================================================================
# MONITORING & ALERTING
# =============================================================================
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1556151207981097060/G8wmrHFffIy6iUc9SFLFtG131QUnp7IOs2Nf3sKuwMO_hUTOw_OrmBNTrijg2yCJjDSU
DISCORD_ALERT_COOLDOWN_SEC=120

# Rate Limiter Tuning
RATE_LIMITER_REQUESTS_SEC=5
RATE_LIMITER_REQUESTS_BURST=10
RATE_LIMITER_PUBLIC_SEC=100
RATE_LIMITER_PUBLIC_BURST=200
RATE_LIMITER_INTERNAL_SEC=50000
RATE_LIMITER_INTERNAL_BURST=100000

# Load Testing Configuration (Grafana k6)
TOTAL_PRODUCTS=5032
CATEGORY_PARAM=category_uuid
PRODUCT_PATH=/api/v1/products
TARGET_RATE=150
BASE_RATE=100
BREAKING_RATE=1500
PEAK_RATE=1000

LIMIT_ITEM_PER_PAGE=10

# Notification data retention (days)
NOTIFICATION_RETENTION_DAYS=60

# REDIS
REDIS_ADDR=localhost:6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=0

# RABBITMQ
RABBITMQ_URL=amqp://goshop:goshop@localhost:5672/

# JWT
JWT_SECRET=CHANGE_ME
JWT_ENCRYPT_KEY=12345678901234561234567890123456

# JWT Asymmetric (RS256) & JWKS (Microservices offline verification)
# In production, set PEM string or file path (e.g. ./keys/jwt_private.pem / ./keys/jwt_public.pem).
# If left empty in development/test, an ephemeral RSA-2048 keypair is automatically generated on boot.
JWT_KEY_ID=goshop-key-1
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# MAILTRAP
MAIL_PROVIDER_TYPE=mailtrap

MAILTRAP_API_KEY=CHANGE_ME
MAILTRAP_SANDBOX_ID=4857919
MAILTRAP_USE_SANDBOX=true
APP_URL=http://localhost:8080

# Browser-facing origin (the edge). Single switch consumed by config.go /
# payment: STOREFRONT_URL, PAYMENT_RETURN_URL and S3_PUBLIC_BASE_URL are all
# derived from it when those vars are left unset. Set APP_ORIGIN per env:
#   dev : http://localhost          (below)
#   prod: https://shop.example.com  (see backend/.env.prod)
APP_ORIGIN=https://shop.example.com
# ^ real domain at deploy time; derives storefront links, VNPay return
#   URL and the public media base. Local edge testing: http://localhost
# Derived: PAYMENT_RETURN_URL + S3_PUBLIC_BASE_URL (see config.go).
# STOREFRONT_URL pinned for dev: email-verify/reset links must hit the
# storefront DEV server (:3001), not the edge ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚Â nginx is stopped in dev-host.
# STOREFRONT_URL=  # derived: ${APP_ORIGIN} (edge) - dev pins :3001 instead

MAILTRAP_MAIL_SENDER=admin@goshop.com
MAILTRAP_MAIL_SENDER_NAME=GOshop Admin


# RABBITMQ
RABBITMQ_URL=amqp://goshop:goshop@localhost:5672/
RABBITMQ_USER=goshop
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_PREFETCH_COUNT=10
RABBITMQ_MESSAGE_TTL_MS=3600000
RABBITMQ_MAX_RETRIES=3
RABBITMQ_CONSUMER_COUNT=3

# MoMo Sandbox
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=CHANGE_ME
MOMO_SECRET_KEY=CHANGE_ME
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# VNPay Sandbox Configuration
VNPAY_TMN_CODE=CHANGE_ME
VNPAY_HASH_SECRET=CHANGE_ME
VNPAY_ENDPOINT=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# PAYMENT CB
PAYMENT_CB_MAX_FAILURES=5
PAYMENT_CB_TIMEOUT_SECONDS=30
PAYMENT_CB_MAX_REQUESTS=1

# PAYMENT URLs
PAYMENT_SERVICE_URL=http://localhost:8083
# PAYMENT_RETURN_URL=        # derived: ${APP_ORIGIN}/payment/result
PAYMENT_WEBHOOK_BASE_URL=https://splotchy-swiftly-nintendo.ngrok-free.dev

# GIAO HANG NHANH (GHN)
GHN_TOKEN=714efcfd-a841-11f1-a973-aee5264794df
GHN_SHOP_ID=217229
GHN_BASE_URL=https://dev-online-gateway.ghn.vn
GHN_CALLBACK_URL=https://splotchy-swiftly-nintendo.ngrok-free.dev/api/v1/shipping/webhook/ghn
ENABLE_LOCATION_FALLBACK=true

SHIPPING_SYNC_INTERVAL_MINUTES=30

# Google OAuth2 Configuration
GOOGLE_CLIENT_ID=15747195180-f3n3p6cujlr9vthn0fd5199pi703f0ah.apps.googleusercontent.com



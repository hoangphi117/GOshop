# =============================================================================
# APPLICATION & RUNTIME
# =============================================================================
# Copy this file to backend/.env.prod and replace every CHANGE_ME placeholder.
# backend/.env.prod must remain git-ignored because it contains real secrets.
#
# APP_ORIGIN is the canonical public origin. When related variables are unset,
# the application derives storefront URLs, payment return URLs, and public
# media URLs from this value.
API_KEY=CHANGE_ME
SERVER_PORT=8080
APP_ENV=production
BASE_URL=http://localhost
APP_ORIGIN=https://shop.example.com
APP_URL=http://localhost:8080

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================
# JWT RS256 key pair
JWT_KEY_ID=goshop-key-1
JWT_PRIVATE_KEY=certs/jwt_private.pem
JWT_PUBLIC_KEY=certs/jwt_public.pem

# JWT compatibility / encryption settings
JWT_SECRET=CHANGE_ME
JWT_ENCRYPT_KEY=CHANGE_ME_32_BYTES

# Internal service-to-service authentication
INTERNAL_API_SECRET=CHANGE_ME

# =============================================================================
# DATABASE
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_SSL_MODE=disable

# Per-service databases
IDENTITY_DB_NAME=shopping_identity
COUPON_DB_NAME=shopping_coupon
PAYMENT_DB_NAME=shopping_payment
INVENTORY_DB_NAME=shopping_inventory
CATALOG_DB_NAME=shopping_catalog
CART_DB_NAME=shopping_cart
ORDER_DB_NAME=shopping_order
REVIEW_DB_NAME=shopping_review
ANALYTICS_DB_NAME=shopping_analytics
CHAT_DB_NAME=shopping_chat
NOTIFICATION_DB_NAME=shopping_notification

# Database connection pool tuning
DB_MAX_CONNS=20
DB_MIN_CONNS=5
DB_READ_MAX_CONNS=15
DB_READ_MIN_CONNS=3

# Optional read replica. If unset, the primary database is used.
# DB_READ_REPLICA_URL=postgres://postgres:postgres@localhost:5433/goshop?sslmode=disable
# Alternatively, configure the read replica using individual fields:
# DB_READ_HOST=localhost
# DB_READ_PORT=5433
# DB_READ_NAME=goshop
# DB_READ_USER=postgres
# DB_READ_PASSWORD=CHANGE_ME
# DB_READ_SSL_MODE=disable

# =============================================================================
# MICROSERVICES ARCHITECTURE
# =============================================================================
# Identity Service
IDENTITY_SERVICE_URL=http://localhost:8081
IDENTITY_SERVER_PORT=8081
IDENTITY_GRPC_PORT=50051
IDENTITY_GRPC_ADDR=localhost:50051

# Notification Service
NOTIFICATION_SERVICE_URL=http://localhost:8082
NOTIFICATION_SERVER_PORT=8082

# Payment Service
PAYMENT_SERVICE_URL=http://localhost:8083
PAYMENT_SERVER_PORT=8083
PAYMENT_GRPC_PORT=50052
PAYMENT_GRPC_ADDR=localhost:50052

# Coupon Service
COUPON_SERVICE_URL=http://localhost:8084
COUPON_SERVER_PORT=8084
COUPON_GRPC_PORT=50053
COUPON_GRPC_TARGET=localhost:50053

# WebSocket Gateway
WS_GATEWAY_URL=http://localhost:8085

# Catalog Service
CATALOG_SERVICE_URL=http://localhost:8086
CATALOG_SERVER_PORT=8086
CATALOG_GRPC_PORT=50055
CATALOG_GRPC_TARGET=localhost:50055

# Cart Service
CART_SERVICE_URL=http://localhost:8087
CART_SERVER_PORT=8087
CART_GRPC_PORT=50056
CART_GRPC_ADDR=localhost:50056

# Order Service
ORDER_SERVICE_URL=http://localhost:8088
ORDER_SERVER_PORT=8088
ORDER_GRPC_PORT=50057
ORDER_GRPC_TARGET=localhost:50057

# Banner Service
BANNER_SERVICE_URL=http://localhost:8089
BANNER_SERVER_PORT=8089

# Inventory Service
INVENTORY_SERVICE_URL=http://localhost:8090
INVENTORY_SERVER_PORT=8090
INVENTORY_GRPC_PORT=50054
INVENTORY_GRPC_TARGET=localhost:50054

# Review Service
REVIEW_SERVICE_URL=http://localhost:8091
REVIEW_SERVER_PORT=8091

# Analytics Service
ANALYTICS_SERVICE_URL=http://localhost:8092
ANALYTICS_SERVER_PORT=8092

# Chat Service
CHAT_SERVICE_URL=http://localhost:8093
CHAT_SERVER_PORT=8093
CHAT_GRPC_PORT=50058
CHAT_GRPC_TARGET=localhost:50058

# Media Service
MEDIA_SERVICE_URL=http://localhost:8094
MEDIA_SERVER_PORT=8094

# =============================================================================
# CACHE & MESSAGE BROKER
# =============================================================================
# Redis
REDIS_ADDR=localhost:6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ
RABBITMQ_URL=amqp://goshop:goshop@localhost:5672/
RABBITMQ_USER=goshop
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_PREFETCH_COUNT=10
RABBITMQ_MESSAGE_TTL_MS=3600000
RABBITMQ_MAX_RETRIES=3
RABBITMQ_CONSUMER_COUNT=3

# =============================================================================
# EMAIL & NOTIFICATIONS
# =============================================================================
MAIL_PROVIDER_TYPE=mailtrap
MAILTRAP_API_KEY=CHANGE_ME
MAILTRAP_SANDBOX_ID=CHANGE_ME
MAILTRAP_USE_SANDBOX=true
MAILTRAP_MAIL_SENDER=CHANGE_ME
MAILTRAP_MAIL_SENDER_NAME=GOshop Admin

# Notification data retention (days)
NOTIFICATION_RETENTION_DAYS=60

# =============================================================================
# PAYMENT GATEWAYS
# =============================================================================
# MoMo Sandbox
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=CHANGE_ME
MOMO_SECRET_KEY=CHANGE_ME
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# VNPay Sandbox
VNPAY_TMN_CODE=CHANGE_ME
VNPAY_HASH_SECRET=CHANGE_ME
VNPAY_ENDPOINT=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# Payment callback handling
PAYMENT_CB_MAX_FAILURES=5
PAYMENT_CB_TIMEOUT_SECONDS=30
PAYMENT_CB_MAX_REQUESTS=1

# Payment URLs
# PAYMENT_RETURN_URL is derived from APP_ORIGIN when left unset.
PAYMENT_WEBHOOK_BASE_URL=

# =============================================================================
# SHIPPING & EXTERNAL INTEGRATIONS
# =============================================================================
# Giao Hang Nhanh (GHN)
GHN_TOKEN=CHANGE_ME
GHN_SHOP_ID=CHANGE_ME
GHN_BASE_URL=https://dev-online-gateway.ghn.vn
GHN_CALLBACK_URL=
ENABLE_LOCATION_FALLBACK=true
SHIPPING_SYNC_INTERVAL_MINUTES=30

# Google OAuth2
GOOGLE_CLIENT_ID=

# =============================================================================
# OBJECT STORAGE
# =============================================================================
# Choose one storage driver and configure its corresponding variables.
#
# Option A: MinIO
# STORAGE_DRIVER=minio
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=auto
# S3_BUCKET=goshop-media
# S3_ACCESS_KEY=CHANGE_ME
# S3_SECRET_KEY=CHANGE_ME
# S3_USE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=
#
# Option B: Cloudflare R2
# Create an R2 bucket and an S3 API token in the Cloudflare dashboard.
# Keep the account ID and credentials in your local, git-ignored .env file.
# STORAGE_DRIVER=r2
# S3_ENDPOINT=https://<CF_ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=goshop-media
# S3_ACCESS_KEY=CHANGE_ME
# S3_SECRET_KEY=CHANGE_ME
# S3_USE_PATH_STYLE=false
# S3_USE_SSL=true
# S3_PUBLIC_BASE_URL=https://pub-<random>.r2.dev
#
# Option C: Local disk
# STORAGE_DRIVER=local
# UPLOAD_DIR=./uploads
# STORAGE_PUBLIC_BASE_URL=http://localhost:8080
#
# If S3_PUBLIC_BASE_URL is unset, the application may derive the public media
# base URL from APP_ORIGIN, as documented in the application configuration.

# =============================================================================
# SEARCH ENGINE
# =============================================================================
# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=CHANGE_ME
MEILISEARCH_INDEX_PRODUCTS=products

# =============================================================================
# API LIMITS & PAGINATION
# =============================================================================
# Rate limiter tuning
RATE_LIMITER_REQUESTS_SEC=5
RATE_LIMITER_REQUESTS_BURST=10
RATE_LIMITER_PUBLIC_SEC=100
RATE_LIMITER_PUBLIC_BURST=200
RATE_LIMITER_INTERNAL_SEC=50000
RATE_LIMITER_INTERNAL_BURST=100000

LIMIT_ITEM_PER_PAGE=10

# =============================================================================
# MONITORING, LOGGING & TRACING
# =============================================================================
# Discord alerting
DISCORD_WEBHOOK_URL=
DISCORD_ALERT_COOLDOWN_SEC=120

# Grafana Cloud Loki (log shipping via Promtail).
# Create a token with the logs:write scope in your Grafana Cloud stack.
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
GRAFANA_LOKI_TOKEN=
GRAFANA_LOKI_READ_TOKEN=

# Grafana Cloud Tempo (production tracing).
# Configure these values in your local, git-ignored backend/.env.prod file.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(instance-id:token)>
# OTEL_TRACES_SAMPLER_ARG=0.1

# =============================================================================
# LOAD TESTING
# =============================================================================
# Grafana k6
TOTAL_PRODUCTS=5032
CATEGORY_PARAM=category_uuid
PRODUCT_PATH=/api/v1/products
TARGET_RATE=150
BASE_RATE=100
BREAKING_RATE=1500
PEAK_RATE=1000

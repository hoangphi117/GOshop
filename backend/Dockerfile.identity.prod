# ============= STAGE 1: BUILD GO BINARY =============
FROM golang:1.26.6-alpine AS builder

RUN apk update && apk add --no-cache git curl

WORKDIR /app

COPY go.mod ./
COPY go.sum ./
RUN go mod download

COPY . .

RUN go build -o identity ./cmd/identity

# ============= STAGE 2: BUILD RUNTIME CONTAINER =============
FROM alpine:3.19

WORKDIR /app

COPY --from=builder /app/identity .

COPY .env .

EXPOSE 8081 50051

CMD ["./identity"]

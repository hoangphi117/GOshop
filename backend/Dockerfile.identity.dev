# ============= STAGE 1: DEV WITH AIR =============
FROM golang:1.26.6-alpine AS builder

RUN apk update && apk add --no-cache git curl

RUN go install github.com/air-verse/air@latest

WORKDIR /app

COPY go.mod ./
COPY go.sum ./
RUN go mod download

COPY . .

EXPOSE 8081 50051

CMD ["air", "-c", ".air.identity.toml"]
